<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Account_Mandatory_On_Case</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISBLANK(AccountId), NOT(ISPICKVAL(Origin, &quot;Web&quot;)) )</errorConditionFormula>
    <errorDisplayField>AccountId</errorDisplayField>
    <errorMessage>Case must be associated with an Account</errorMessage>
</ValidationRule>
