<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Resolution_Time_Required_On_Close</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISPICKVAL(Status, &quot;Closed&quot;), ISBLANK(Resolution_Time__c)
)</errorConditionFormula>
    <errorDisplayField>Resolution_Time__c</errorDisplayField>
    <errorMessage>Resolution Time must be entered before closing the case</errorMessage>
</ValidationRule>
